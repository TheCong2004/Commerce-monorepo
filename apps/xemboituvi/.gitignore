!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/lib/generated/prisma

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Build artifacts
dist/
*.local

# Package manager
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnpm-store/

# Logs
logs/
*.log
lerna-debug.log*

# Testing
.jest/
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/
.temp/

# Large media files (should be hosted elsewhere or use Git LFS)
